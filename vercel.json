{
  "version": 2,
  "rewrites": [
    {
      "source": "/auth/spotify/callback",
      "destination": "/api/index.ts?route=callback"
    },
    {
      "source": "/auth/spotify/callback/",
      "destination": "/api/index.ts?route=callback"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
