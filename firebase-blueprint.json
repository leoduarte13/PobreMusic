{
  "entities": {
    "User": {
      "title": "User",
      "description": "Google authenticated user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Google user UID" },
        "email": { "type": "string", "description": "Google email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User profile photo URL" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" }
      },
      "required": ["id"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "User-isolated playlist document stored in cloud Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique playlist identifier", "maxLength": 128 },
        "userId": { "type": "string", "description": "Owner Google User UID", "maxLength": 128 },
        "name": { "type": "string", "description": "Playlist name", "maxLength": 150 },
        "description": { "type": "string", "description": "Playlist description", "maxLength": 500 },
        "cover": { "type": "string", "description": "Cover image URL" },
        "tracks": { "type": "array", "description": "Array of track objects" },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "updatedAt": { "type": "number", "description": "Last update timestamp in milliseconds" },
        "isCloud": { "type": "boolean", "description": "Flag indicating cloud sync status" }
      },
      "required": ["id", "userId", "name"]
    }
  },
  "firestore": {
    "/users/{userId}/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/Playlist" },
      "description": "Private collection of playlists owned and accessible only by the authenticated user"
    }
  }
}

