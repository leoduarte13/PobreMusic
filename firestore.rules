rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPlaylist(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.tracks is list && data.tracks.size() <= 500 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('cover' in data) || (data.cover is string && data.cover.size() <= 2000));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile Document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Private User-isolated Playlists Subcollection
      match /playlists/{playlistId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(playlistId) && isValidPlaylist(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(playlistId) && isValidPlaylist(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(playlistId);
      }
    }
  }
}

